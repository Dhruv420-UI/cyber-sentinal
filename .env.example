# CyberSentinel AI Environment Configuration Example
# Copy this file to .env and provide your own values.
# DO NOT commit real secrets to source control.

# Backend Gemini LLM Integration
# Set your Google  API key to enable autonomous AI Analyst responses.
# When not set, the agent operates in fail-closed deterministic template mode.
GEMINI_API_KEY=

# Optional: Override Gemini model (e.g. gemini-3.6-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.6-flash

# Security Middleware & API Protection
CYBERSENTINEL_API_KEY=
CYBERSENTINEL_RATE_LIMIT=120
CYBERSENTINEL_MAX_WS_CONNECTIONS=50

# Server Configuration
HOST=0.0.0.0
PORT=8000
